# ==============================================================================
# SaltDistribute - Database & Environment Configuration Settings
# ==============================================================================

# Backend Server Port & Host
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. MongoDB Database Settings (Recommended for Production Document Store)
# ------------------------------------------------------------------------------
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
DB_NAME=saltdistribute_db

# MongoDB Atlas (Cloud Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# DB_NAME=saltdistribute_production

# ------------------------------------------------------------------------------
# 2. SQLite / Relational Settings (Zero-Config Embedded Database)
# ------------------------------------------------------------------------------
SQLITE_DB_PATH=saltdistribute.db
DATABASE_URL=sqlite:///./saltdistribute.db

# ------------------------------------------------------------------------------
# 3. Firebase Cloud Firestore & Client Config Settings
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=saltdistribute-2026
FIREBASE_STORAGE_BUCKET=saltdistribute-2026.firebasestorage.app

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBYSp8NGhg_CXDhbGqc74jW58PfQjS3wEI
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=saltdistribute-2026.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=saltdistribute-2026
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=saltdistribute-2026.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=307526299576
EXPO_PUBLIC_FIREBASE_APP_ID=1:307526299576:web:d5cf416af5f366fd87a94d
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-Q67D1MSDZF
EXPO_PUBLIC_FIREBASE_VAPID_KEY=BP3H-WrZO3cHy9lieTIDTlWDAJJxUGYPic1THx2U6ypqsVKFaRs-Zxd1uZhP1rojBvLDK_P09m1mDEv2XzNOtmU

# ------------------------------------------------------------------------------
# 4. Frontend API Endpoint Settings (React Native / Expo Web & Mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_DEFAULT_LANG=id

# ------------------------------------------------------------------------------
# 5. CARTO Basemaps & Tile Vector Service API Key
# ------------------------------------------------------------------------------
EXPO_PUBLIC_CARTO_API_KEY=YOUR_CARTO_API_KEY_HERE

# ------------------------------------------------------------------------------
# 6. Firebase App Check (reCAPTCHA Enterprise Site Key)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY_HERE
