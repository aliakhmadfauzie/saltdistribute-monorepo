rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Inventory collection: Public read, admin write
    match /inventory/{docId} {
      allow read: if true;
      allow write: if request.auth != null || true; // Demo / Admin role
    }

    // Store settings & meeting points: Public read, admin write
    match /store_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /meeting_points/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection: Public create (guest orders), buyer & admin read/update
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Chats collection
    match /chats/{bookingId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
